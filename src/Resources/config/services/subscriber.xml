<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="PaazlCheckoutWidget\Subscriber\PaazlCheckoutSubscriber">
            <tag name="kernel.event_subscriber"/>
            <argument type="service" id="PaazlCheckoutWidget\RestApi\PaazlApiTokenProvider"/>
            <argument type="service" id="PaazlCheckoutWidget\Service\GeneratePaazlScript"/>
            <argument type="service" id="monolog.logger.paazl" />
        </service>

        <service id="PaazlCheckoutWidget\Subscriber\PaidOrderSubscriber">
            <tag name="kernel.event_subscriber"/>
            <argument type="service" id="order_transaction.repository"/>
            <argument type="service" id="PaazlCheckoutWidget\Service\PaazlConfiguration"/>
            <argument type="service" id="PaazlCheckoutWidget\Service\OrderExportService"/>
            <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextRestorer"/>
        </service>

        <service id="PaazlCheckoutWidget\Subscriber\CartConvertSubscriber">
            <tag name="kernel.event_subscriber"/>
            <argument type="service" id="country.repository"/>
            <argument type="service" id="PaazlCheckoutWidget\Service\PaazlConfiguration"/>
        </service>

        <service id="PaazlCheckoutWidget\Subscriber\OrderPlacedSubscriber">
            <tag name="kernel.event_subscriber"/>
            <argument type="service" id="PaazlCheckoutWidget\Service\PaazlConfiguration"/>
            <argument type="service" id="PaazlCheckoutWidget\Service\OrderExportService"/>
        </service>

        <service id="PaazlCheckoutWidget\Subscriber\MailBeforeValidateSubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="PaazlCheckoutWidget\Subscriber\CustomerLogoutSubscriber">
            <tag name="kernel.event_subscriber"/>
            <argument type="service" id="PaazlCheckoutWidget\Service\CartPaazlTokenService"/>
        </service>

        <service id="PaazlCheckoutWidget\Subscriber\ShippingMethodLoadedSubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>
    </services>
</container>
