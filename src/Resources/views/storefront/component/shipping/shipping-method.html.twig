{% sw_extends '@Storefront/storefront/component/shipping/shipping-method.html.twig' %}

{% block component_shipping_method_field %}
    {% set isTokenSet = page.paazlTokenData['token'] is string %}

    {% if (config('PaazlCheckoutWidget.config.hideNonPaazlShippingOptions') == 'yes') and isTokenSet %}
        {% if shipping.customFields.paazlName == constant('PaazlCheckoutWidget\\PaazlCheckoutWidget::SHIPPING_METHOD_NAME') %}
            {{ parent() }}
        {% endif %}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block component_shipping_method_input %}
    <input type="radio"
           id="shippingMethod{{ shipping.id }}"
           name="shippingMethodId"
           value="{{ shipping.id }}"
           {% if shipping.id === context.shippingMethod.id %}checked="checked"{% endif %}
           class="form-check-input shipping-method-input {% if config('PaazlCheckoutWidget.config.hideNonPaazlShippingOptions') == 'yes' and isTokenSet %}paazl-method-class{% endif %}">
{% endblock %}

{% block component_shipping_method_control %}
    {% if (config('PaazlCheckoutWidget.config.hideNonPaazlShippingOptions') == 'yes') and isTokenSet %}
        <div class="paazl-hide-radio">
            {{ parent() }}
        </div>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

